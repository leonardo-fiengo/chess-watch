template("build_executable") {
    forward_variables_from(invoker, ["sources", "public_configs", "configs", "deps", "libs", "lib_dirs", "native_build_path"])

    output_dir = "$native_build_path/$native_out_dir/bin"
    executable(target_name) {
        configs += [
            "$tizen_core/build/native:executable_config",
            "$tizen_core/build/native:profile_config",
        ]
    }
}

