<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://tizen.org/ns/packages" api-version="{{manifest_api_version}}" package="org.tizen.example.{{project_name}}" version="1.0.0">
	<profile name="wearable" />
	<watch-application appid="org.tizen.example.{{project_name}}" exec="{{project_name}}.dll" type="{{project_type}}" ambient-support="false" 
	{{manifest_api_version2}}>
    <label>{{project_name}}</label>
	  <icon>{{project_name}}.png</icon>
    <metadata key="http://tizen.org/metadata/prefer_dotnet_aot" value="true" />
    <splash-screens />
  </watch-application>
  <privileges>
    <privilege>http://tizen.org/privilege/alarm.set</privilege>
  </privileges>
</manifest>
