declare_args() {
    # Default Tizen profile for the build
    profile = "{{ProfileID}}"

    # Default Tizen version for the build
    api_version = "{{APIVersion}}"

    # Default Build type [Debug/ Release/ Test]
    build_type = "{{BuildType}}"

    ws_path = "{{Path}}"

    # Build with debug info
    debug_build = true

    # Build with tests
    test_build = false
}

contains_native_proj = false
{{- if or .Native .NativeTests }}

contains_native_proj = true

declare_args() {

    # Default rootstrap to use for build [llvm/ gcc]
    rootstrap = "{{Rootstrap}}"

    # Default compiler to use for build [llvm/ gcc]
    compiler = "{{compiler}}"

    # default architecture to build for [x86/ x86_64/ arm/ aarch64/ riscv64]
    arch = "{{Arch}}"

    # Pass verbose option to tools
    verbose_build = false

    # Strip debug info from final binary
    strip_debug_info = false

}
target_cpu = arch

test_incs = []
if (test_build) {
    test_incs = [
        {{- range .NativeTests}}
        "//{{.Path}}/inc",
        {{- end}}
    ]
    {{- if .Coverage}}
    coverage = "{{.Coverage}}"
    {{- end}}
}


{{- end}}

{{- if or .Dotnet }}
#Skip dotnet/msbuild for dotnet build
skip_dotnet_build = {{.SkipDotnetBuild}}

# Default path for dotnet-cli
dotnet_cli_path = "{{dotnet_cli_path}}"

# Default path for msbuild
msbuild_path = "{{msbuild_path}}"

# sln_path path for dotnet project
sln_path = "{{sln_path}}"

# Default tool for dotnet build [dotnet-cli/ msbuild]
dotnet_build_tool = "{{dotnet_build}}"

# Working folder for dotnet workspace, paths to csproj or sln
working_folder= "{{WorkingFolder}}"{{- end}}

    
{{- if .DeviceSerial}}
# Serial of the target device
device_serial = "{{.DeviceSerial}}"{{- end}}

{{- if .TargetName}}
# Name of the target device
target_device = "{{.TargetName}}"{{- end}}

target_os = "linux"

{{- if .WebInspector}}
web_inspector = "{{.WebInspector}}"
chrome_path = "{{chrome_path}}"
inspector_options = "{{chrome_inspector_options}}"
inspector_data_path= "{{chrome_inspector_data_path}}"
{{- end}}


# hybrid ws
hyb_web_pkg = "{{hyb_web_pkg}}"
hyb_native_pkg = "{{hyb_native_pkg}}"
hyb_native_pkg_id = "{{hyb_native_pkg_id}}"
hyb_native_pkg_ver = "{{hyb_native_pkg_ver}}"
hyb_dotnet_pkg = "{{hyb_dotnet_pkg}}"
hyb_dotnet_dep_pkgs = "{{hyb_dotnet_dep_pkgs}}"
hyb_resource_pkg = "{{hyb_resource_pkg}}"
hyb_base_pkg = "{{hyb_base_pkg}}"
hyb_final_pkg = "{{hyb_final_pkg}}"
hyb_final_pkg_id = "{{hyb_final_pkg_id}}"
hyb_final_app_id = "{{hyb_final_app_id}}"
hyb_final_pkg_type = "{{hyb_final_pkg_type}}"
hyb_web_widget_id = "{{hyb_web_widget_id}}"
utc_bin_path = "{{utc_bin_path}}"
native_test_path = "{{native_test_path}}"
hyb_action_code = "{{hyb_action_code}}"
unity_pkg = "{{unity_pkg}}"
deps_type = "{{deps_type}}"
multi_build = {{.MultiBuild}}
arch_version = {{.ArchVersion}}
hyb_pack_check = {{hyb_pack_check}}
contains_ime_category = {{contains_ime_category}}
widget_app = {{widget_app}}

native_projects_path = [
{{- range native_projects_path}}
    "{{.}}",
{{- end}}
]

profiles_path = "{{profiles_xml_path}}"
signing_profile = "{{sign_profile}}"
# set opt if non empty web projects
if (hyb_web_pkg != ""){
    opt = {{Optimize}}
}

# using native toolchain for hybrid build,
rootstrap = "{{Rootstrap}}"
compiler = "{{compiler}}"
arch = "{{Arch}}"
verbose_build = false
strip_debug_info = false


# Use default signing profile for packaging
default_signing_profile = "{{default_signing_profile}}"

# Author certificate for package signing
author_cert = "{{to_slash author_cert}}"

# Distributor certificate for package signing
distributor_cert = "{{to_slash dist_cert}}"

# Distributor2 certificate for package signing
distributor2_cert = "{{to_slash dist2_cert}}"

# Author profile item password attr 
author_pass_attr = "{{author_pass_attr}}"

# Distributor profile item password attr 
distributor_pass_attr = "{{dist_pass_attr}}"

# Distributor2 profile item password attr 
distributor2_pass_attr = "{{dist2_pass_attr}}"

# Tizen Studio path
tizen_studio = "{{to_slash tizen_studio}}"

# Tizen core path
tizen_core = "{{to_slash tizen_core}}"

# Out directory for native package file
native_out_dir = "tpk"

web_out_dir = "wgt"

resource_out_dir = "rpk"


# Source path filter patterns
exclude_patterns = [
{{- range .SrcFilters}}
    "{{.}}",
{{- end}}
]

# Test source path pattern
test_src_patterns = [
{{- range .TestFilters}}
    "{{.}}",
{{- end}}
]

if (!test_build) {
    exclude_patterns += test_src_patterns
}

set_sources_assignment_filter(exclude_patterns)
if (contains_native_proj){
    set_default_toolchain(":${arch}_${compiler}")
} else {
    set_default_toolchain("${tizen_core}/dotnet/toolchains:dotnet_builder")
}